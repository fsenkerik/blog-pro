# Database
# Railway MySQL exposes MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD and MYSQLDATABASE.
# The app also supports the DB_* aliases below for local hosting or manual setup.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog_pro
DB_USER=root
DB_PASS=root

# App
APP_ENV=production
BASE_URL=https://your-app.up.railway.app/
